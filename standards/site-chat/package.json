{
  "name": "@atengku/site-chat",
  "version": "1.0.1",
  "description": "Standard ElevenLabs Agents chat surface for every site we ship on Vercel.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["dist", "templates", "bin", "README.md", "ADOPTION.md", "CHANGELOG.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "site-chat": "./bin/site-chat.mjs" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./react": { "types": "./dist/react/index.d.ts", "default": "./dist/react/index.js" },
    "./server": { "types": "./dist/server/index.d.ts", "default": "./dist/server/index.js" },
    "./embed": { "types": "./dist/embed/index.d.ts", "default": "./dist/embed/index.js" },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node bin/site-chat.mjs check"
  },
  "peerDependencies": {
    "@elevenlabs/client": ">=1.21.0 <2",
    "@elevenlabs/react": ">=1.13.0 <2",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@elevenlabs/react": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@elevenlabs/client": "^1.21.0",
    "@elevenlabs/react": "^1.13.0",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.3"
  },
  "overrides": { "livekit-client": "2.16.1" },
  "engines": { "node": ">=20" }
}
